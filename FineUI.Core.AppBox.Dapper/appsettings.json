{
  "FineUI": {
    "EnableRazorForms": true,
    "AllowDangerousRawTag": false,
    "AllowDangerousScriptTag": false,
    "DebugMode": true,
    "Theme": "Pure_Black",
    "EnableAnimation": false,
    "MobileAdaption": false,
    "CustomScrollbar": true,
    "FormRedStarPosition": "BeforeText",
    "FormLabelAlign": "Right",
    "GridHeaderFilterIconVisible": true,
    "GridHeaderSortIconVisible": true,
    "GridPagingToolbarVisible": true,
    "GridPagerAlignRight": true,
    "GridShowSelectionMessage": true,
    "GridPagingType": "Arrow"
  },
  "ConnectionStrings": {
    "MySQL": "Server=localhost;Database=fineui_core_appbox;Uid=root;Pwd=pass;Charset=utf8"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
